# Copy to deploy/production.env. This file must remain private.
PUBLIC_DOMAIN=pay.your-domain.example
PUBLIC_FRONTEND_URL=https://pay.your-domain.example
CORS_ORIGINS=https://pay.your-domain.example
# Use a fresh database for live money; never copy simulated balances.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-secret
MYSQL_PASSWORD=replace-with-a-different-long-random-secret
# URI-encode special characters in the database password inside DATABASE_URL.
DATABASE_URL=mysql+pymysql://bridge:replace-with-a-different-long-random-secret@db:3306/bridgeescrow
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-a-different-32-character-random-secret
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_FROM=
MAIL_PASSWORD=
# Start with provider sandbox credentials; test before selecting daraja_live.
PAYMENT_MODE=daraja_sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://pay.your-domain.example/api/callbacks/mpesa
MPESA_CALLBACK_TOKEN=
# B2C must be approved separately and funded by your business.
MPESA_B2C_ENABLED=0
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=https://pay.your-domain.example/api/payouts/result
MPESA_B2C_TIMEOUT_URL=https://pay.your-domain.example/api/payouts/timeout
DEVELOPER_LIVE_ENABLED=0
SMS_MODE=africastalking
AT_ENVIRONMENT=sandbox
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
USSD_ENVIRONMENT=sandbox
USSD_CALLBACK_TOKEN=
USSD_SERVICE_CODE=
