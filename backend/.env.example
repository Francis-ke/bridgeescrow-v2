# Sender account only. OTP recipients come from each user's registration email.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_FROM=
# App password for the sender account; keep the actual value in backend/.env.
MAIL_PASSWORD=

FLASK_RUN_PORT=5050
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
PUBLIC_FRONTEND_URL=http://127.0.0.1:5180

# --- Phone, SMS, USSD and M-PESA provider setup ---
# Keep simulated until credentials, HTTPS callbacks and provider tests are ready.
PAYMENT_MODE=simulated
SMS_MODE=simulated
# SMS_MODE: simulated or africastalking. AT_ENVIRONMENT: sandbox or live.
AT_ENVIRONMENT=sandbox
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Use a long random token. Provider callback: /api/ussd/gateway/<token>
USSD_CALLBACK_TOKEN=
# Paste the exact code provisioned by your USSD provider.
USSD_SERVICE_CODE=
# PAYMENT_MODE: simulated, daraja_sandbox or daraja_live.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public base callback URL, e.g. https://your-domain/api/callbacks/mpesa
# The application appends /<payment-reference>/<MPESA_CALLBACK_TOKEN> to this URL.
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
# Enable only with approved B2C credentials and a clean live database.
MPESA_B2C_ENABLED=0
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=
MPESA_B2C_TIMEOUT_URL=

# Enable production merchant M-PESA only after provider tests on a clean database.
DEVELOPER_LIVE_ENABLED=0

# Use live only for a provisioned carrier USSD code.
USSD_ENVIRONMENT=sandbox
